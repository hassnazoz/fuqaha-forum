---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout title="عن المنتدى - منتدى الفقهاء الليبيين">
  <main class="container main-grid">
    <div class="content-column">
      <div class="article-single">
        <h1 class="article-single-title">عن منتدى الفقهاء الليبيين</h1>
        <div class="article-body">
          <p>منتدى الفقهاء الليبيين مؤسسة علمية مستقلة تعنى بالدراسات والبحوث الشرعية، وتهدف إلى إثراء الساحة العلمية بالأبحاث الرصينة والفتاوى والنوازل المعاصرة.</p>
          <p>يمكنك تعديل هذا النص لاحقاً بما يناسب التعريف والأهداف والهيئة العلمية للمنتدى.</p>
        </div>
      </div>
    </div>
    <Sidebar />
  </main>
</Layout>